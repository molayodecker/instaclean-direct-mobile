# Mithril API — same backend as instaclean-direct web.
# Local `expo start`: copy to `.env` and use staging (default below).
EXPO_PUBLIC_MITHRIL_API_URL=https://instaclean-mithril-staging.fly.dev
EXPO_PUBLIC_MITHRIL_ENV=staging

# Sentry (org: instaclean-inc, project: instaclean-direct-mobile)
# Create the React Native project in Sentry if needed, then paste the Client Key DSN.
EXPO_PUBLIC_SENTRY_DSN=

# EAS Build: set SENTRY_AUTH_TOKEN as a secret (Organization Auth Token with release + source map scope).
# Plugin reads org/project from app.json @sentry/react-native/expo.

# Optional overrides:
# EXPO_PUBLIC_MITHRIL_API_URL=http://192.168.x.x:4000
# EXPO_PUBLIC_MITHRIL_ENV=local

# OpenAPI source for `npm run api:generate` (defaults to staging OpenAPI)
# MITHRIL_OPENAPI_URL=https://instaclean-mithril-staging.fly.dev/openapi.json
